{"id": "viva_tellurium.composites.decay-demo", "name": "decay-demo", "description": "Tiny Tellurium / Antimony decay demo: S1 -> S2 first-order kinetics. Emits species concentrations, reaction rates, and time each step.", "parameters": {"interval": {"type": "float", "default": 1.0, "description": "Process interval in model time units. Each update advances RoadRunner by this much."}, "k_decay": {"type": "float", "default": 0.3, "description": "First-order decay rate constant for S1 -> S2."}, "s1_initial": {"type": "float", "default": 10.0, "description": "Initial concentration of S1."}}, "state": {"tellurium": {"_type": "process", "address": "local:TelluriumProcess", "config": {"model": "model decay\n  S1 = 10; S2 = 0\n  S1 -> S2; k*S1; k = 0.3\nend\n", "model_format": "antimony", "integrator": "cvode", "species_overrides": {"S1": 10.0}, "parameter_overrides": {"k": 0.3}}, "inputs": {}, "outputs": {"species": ["stores", "species"], "rates": ["stores", "rates"], "parameters": ["stores", "parameters"], "time": ["stores", "time"]}, "interval": 1.0, "interval_label": "1 s"}, "stores": {"species": {}, "rates": {}, "parameters": {}, "time": 0.0}, "emitter": {"_type": "step", "address": "local:RAMEmitter", "config": {"emit": {"species": "array[float]", "rates": "map[float]", "parameters": "map[float]", "time": "float"}}, "inputs": {"species": ["stores", "species"], "rates": ["stores", "rates"], "parameters": ["stores", "parameters"], "time": ["stores", "time"]}}, "_declared_emit_paths": ["stores/species", "stores/rates", "stores/parameters", "stores/time"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["TelluriumProcess", "RAMEmitter"]}, "tags": ["systems-biology", "ode", "sbml", "demo"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "preferred_time": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}