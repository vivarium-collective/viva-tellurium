{"id": "viva_tellurium.composites.decay-with-viz", "name": "decay-with-viz", "description": "Tellurium decay demo with a wired Visualization Step. Each update produces a Plotly HTML figure of the running species trajectories, written to the 'viz_html' store.", "parameters": {"interval": {"type": "float", "default": 1.0, "description": "Process interval in model time units."}, "viz_title": {"type": "string", "default": "Tellurium decay (S1 -> S2)", "description": "Title displayed at the top of the Plotly figure."}}, "state": {"tellurium": {"_type": "process", "address": "local:TelluriumProcess", "config": {"model": "model decay\n  S1 = 10; S2 = 0\n  S1 -> S2; k*S1; k = 0.3\nend\n", "model_format": "antimony", "integrator": "cvode"}, "inputs": {}, "outputs": {"species": ["stores", "species"], "rates": ["stores", "rates"], "parameters": ["stores", "parameters"], "time": ["stores", "time"]}, "interval": 1.0, "interval_label": "1 s"}, "stores": {"species": {}, "rates": {}, "parameters": {}, "time": 0.0, "viz_html": ""}, "viz": {"_type": "step", "address": "local:SpeciesTimeSeriesPlots", "config": {"title": "Tellurium decay (S1 -> S2)", "species_names": ["S1", "S2"]}, "inputs": {"species": ["stores", "species"], "time": ["stores", "time"]}, "outputs": {"html": ["stores", "viz_html"]}}, "emitter": {"_type": "step", "address": "local:RAMEmitter", "config": {"emit": {"species": "array[float]", "rates": "map[float]", "time": "float"}}, "inputs": {"species": ["stores", "species"], "rates": ["stores", "rates"], "time": ["stores", "time"]}}, "_declared_emit_paths": ["stores/species", "stores/rates", "stores/time"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["TelluriumProcess", "SpeciesTimeSeriesPlots", "RAMEmitter"]}, "tags": ["systems-biology", "ode", "sbml", "demo", "visualization"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "preferred_time": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}